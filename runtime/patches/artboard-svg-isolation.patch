+/// 复制单画板需要的原生绘制对象；未知范围保留，锁定不影响导出。
+/// 普通无外观图层可筛选子项；群组、裁切与非平凡容器保持完整依赖。
+fn artboard_part(node: &Node, rect: vectorcraft_geom::Rect) -> Option<Node> {
+    if matches!(node.kind, NodeKind::Layer { clip: false, .. })
+        && node.appearance == Default::default() && node.mask.is_none() && node.wrap.is_none() && node.graph.is_none()
+        && node.opacity == 1.0 && node.blend == Default::default() && node.knockout == Default::default()
+        && !node.isolate && !node.knockout_shape
+        && !node.children().is_some_and(|children| children.iter().any(|child| has_uncertain_dependency(child)))
+    {
+        let children = node.children()?;
+        let kept: Vec<Arc<Node>> = children.iter().filter_map(|child| artboard_part(child, rect)).map(Arc::new).collect();
+        if kept.is_empty() { return None; }
+        let mut result = node.clone();
+        *result.children_mut()? = kept;
+        return Some(result);
+    }
+    // 未知子项范围与文字绕排会产生跨对象依赖，保守保留容器。
+    if has_uncertain_dependency(node) { return Some(node.clone()); }
+    if vectorcraft_render::export_bounds(node).is_some_and(|bounds| bounds.intersect(rect).area() <= 0.0 && !rect.contains(bounds.center())) {
+        return None;
+    }
+    Some(node.clone())
+}
+
+/// 无法安全判断绘制范围或跨对象排版依赖时，保留整个依赖容器。
+fn has_uncertain_dependency(node: &Node) -> bool {
+    node.wrap.is_some() || vectorcraft_render::export_bounds(node).is_none()
+        || node.children().is_some_and(|children| children.iter().any(|child| has_uncertain_dependency(child)))
+}
