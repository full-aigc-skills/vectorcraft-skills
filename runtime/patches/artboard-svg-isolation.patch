@@ -0,0 +1,93 @@
+//! 单画板 SVG 资产隔离：显式锁定对象、描边外扩、空画板与源文档保全。
+use serde_json::json;
+use std::sync::Arc;
+use vectorcraft_doc::NodeId;
+use super::*;
+
+fn scene() -> Session {
+    let mut s = Session::new();
+    s.execute("file.new", &json!({"width":80,"height":64})).unwrap();
+    s
+}
+
+fn rectangle(s: &mut Session, x:f64, y:f64, color:&str) -> NodeId {
+    let made=s.execute("shape.rectangle", &json!({"x":x,"y":y,"width":20,"height":20})).unwrap();
+    s.execute("paint.setFill", &json!({"color":color})).unwrap();
+    s.execute("paint.setStroke", &json!({"none":true})).unwrap();
+    NodeId(made["id"].as_u64().unwrap())
+}
+
+#[test]
+fn artboard_isolation_keeps_locked_visible_content_and_removes_remote_art() {
+    let mut s=scene();
+    let inside=rectangle(&mut s,20.0,16.0,"#22aa66");
+    Arc::make_mut(&mut s.doc_mut().unwrap().doc).node_mut(inside).unwrap().locked=true;
+    let remote=rectangle(&mut s,200.0,20.0,"#2366e8");
+    let before=serde_json::to_value(&*s.doc().unwrap().doc).unwrap();
+    let selection_before=format!("{:?}",s.doc().unwrap().selection);
+    let svg=tests_svg::svg(&mut s,json!({"artboard":0,"artboardContentOnly":true}));
+    assert!(svg.contains("#22aa66"),"locked visible content omitted: {svg}");
+    assert!(!svg.contains("#2366e8"),"remote art leaked: {svg}");
+    assert_eq!(before,serde_json::to_value(&*s.doc().unwrap().doc).unwrap());
+    assert_eq!(selection_before,format!("{:?}",s.doc().unwrap().selection));
+    s.execute("paint.setFill", &json!({"ids":[remote.0],"color":"#175cce"})).unwrap();
+    assert_eq!(svg,tests_svg::svg(&mut s,json!({"artboard":0,"artboardContentOnly":true})));
+}
+
+#[test]
+fn artboard_isolation_keeps_stroke_reaching_inside_from_outside_geometry() {
+    let mut s=scene();
+    rectangle(&mut s,-25.0,16.0,"#2366e8");
+    s.execute("paint.setStroke", &json!({"color":"#e96340"})).unwrap();
+    s.execute("stroke.set", &json!({"weight":16})).unwrap();
+    let svg=tests_svg::svg(&mut s,json!({"artboard":0,"artboardContentOnly":true}));
+    assert!(svg.contains("#e96340"),"stroke extent omitted: {svg}");
+}
+
+#[test]
+fn artboard_isolation_empty_board_and_bad_index_preserve_source() {
+    let mut s=scene();rectangle(&mut s,200.0,20.0,"#2366e8");
+    let svg=tests_svg::svg(&mut s,json!({"artboard":0,"artboardContentOnly":true}));
+    assert!(svg.contains("viewBox=\"0 0 80 64\""));assert!(!svg.contains("<path"));
+    assert!(s.execute("document.serialize", &json!({"format":"svg","artboard":9,"artboardContentOnly":true})).is_err());
+    assert!(s.execute("document.serialize", &json!({"format":"svg","artboard":0,"artboardContentOnly":true,"selectedOnly":true})).is_err());
+}
+
+#[test]
+fn artboard_isolation_keeps_shadow_reaching_the_board() {
+    let mut s=scene();let id=rectangle(&mut s,-50.0,16.0,"#2366e8");
+    let node=Arc::make_mut(&mut s.doc_mut().unwrap().doc).node_mut(id).unwrap();
+    node.appearance.effects.push(vectorcraft_doc::Effect { id:"stylize.dropShadow".into(),params:json!({"x":45,"y":0,"blur":2,"opacity":100}),visible:true });
+    let svg=tests_svg::svg(&mut s,json!({"artboard":0,"artboardContentOnly":true}));
+    assert!(svg.contains("#2366e8"),"shadow source omitted: {svg}");
+}
+
+#[test]
+fn artboard_isolation_retains_complete_clipping_group() {
+    let mut s=scene();let clip=rectangle(&mut s,10.0,10.0,"#22aa66");let remote=rectangle(&mut s,200.0,20.0,"#2366e8");
+    let doc=Arc::make_mut(&mut s.doc_mut().unwrap().doc);
+    let clip_node=Arc::new(doc.node(clip).unwrap().clone());let remote_node=Arc::new(doc.node(remote).unwrap().clone());
+    let group_id=doc.alloc_id();let mut group=vectorcraft_doc::Node::group(group_id,vec![clip_node,remote_node]);
+    if let vectorcraft_doc::NodeKind::Group { clip, .. } = &mut group.kind { *clip=true; }
+    *Arc::make_mut(&mut doc.layers[0]).children_mut().unwrap()=vec![Arc::new(group)];
+    let before=serde_json::to_value(&*s.doc().unwrap().doc).unwrap();
+    let svg=tests_svg::svg(&mut s,json!({"artboard":0,"artboardContentOnly":true}));
+    assert!(svg.contains("clipPath"),"clipping container lost: {svg}");assert!(svg.contains("#2366e8"),"container children lost: {svg}");
+    assert_eq!(before,serde_json::to_value(&*s.doc().unwrap().doc).unwrap());
+}
+
+#[test]
+fn artboard_isolation_rejects_conflicting_options_and_preserves_legacy_export() {
+    let mut s=scene();rectangle(&mut s,200.0,20.0,"#2366e8");
+    let original=serde_json::to_value(&*s.doc().unwrap().doc).unwrap();
+    let legacy=tests_svg::svg(&mut s,json!({"artboard":0}));
+    assert!(legacy.contains("#2366e8"));
+    assert_eq!(legacy,tests_svg::svg(&mut s,json!({"artboard":0,"artboardContentOnly":false})));
+    for extra in [json!({"artboardContentOnly":"true"}),json!({"artboard":-1}),json!({"artboards":[0,1]}),json!({"range":"all"}),json!({"useArtboards":false}),json!({"svg":{"artboard":0}})] {
+        let mut params=json!({"format":"svg","artboard":0,"artboardContentOnly":true});
+        params.as_object_mut().unwrap().extend(extra.as_object().unwrap().clone());
+        assert!(s.execute("document.serialize", &params).is_err(),"conflict accepted: {params}");
+        assert_eq!(original,serde_json::to_value(&*s.doc().unwrap().doc).unwrap());
+    }
+    assert!(s.execute("document.serialize", &json!({"format":"png","artboard":0,"artboardContentOnly":true})).is_err());
+}
